{
  "uid": "m5-test-quality",
  "title": "Test Quality Overview (M5)",
  "tags": ["m5", "qa", "automation"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-7d", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Pass rate (7d rolling)",
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 0.85 },
              { "color": "green", "value": 0.95 }
            ]
          }
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "influxdb", "uid": "influxdb" },
          "query": "from(bucket: \"test-runs\") |> range(start: -7d) |> filter(fn: (r) => r._measurement == \"test_run\" and r._field == \"status\") |> mean()"
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Flaky rate (7d)",
      "gridPos": { "h": 6, "w": 6, "x": 6, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.05 },
              { "color": "red", "value": 0.1 }
            ]
          }
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "influxdb", "uid": "influxdb" },
          "query": "from(bucket: \"test-runs\") |> range(start: -7d) |> filter(fn: (r) => r._measurement == \"flaky_verdict\" and r._field == \"should_quarantine\") |> mean()"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "MTTR (mean time to repair, days)",
      "gridPos": { "h": 6, "w": 6, "x": 12, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "unit": "d",
          "decimals": 1
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "influxdb", "uid": "influxdb" },
          "query": "from(bucket: \"test-runs\") |> range(start: -30d) |> filter(fn: (r) => r._measurement == \"mttr\" and r._field == \"days\") |> mean()"
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Coverage (last run)",
      "gridPos": { "h": 6, "w": 6, "x": 18, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 0.7 },
              { "color": "green", "value": 0.85 }
            ]
          }
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "influxdb", "uid": "influxdb" },
          "query": "from(bucket: \"test-runs\") |> range(start: -7d) |> filter(fn: (r) => r._measurement == \"coverage\" and r._field == \"line_pct\") |> last()"
        }
      ]
    },
    {
      "id": 5,
      "type": "table",
      "title": "Top-5 flaky tests",
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 6 },
      "options": { "showHeader": true },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "influxdb", "uid": "influxdb" },
          "query": "from(bucket: \"test-runs\") |> range(start: -30d) |> filter(fn: (r) => r._measurement == \"flaky_verdict\" and r._field == \"pass_rate\") |> group(columns: [\"test_id\"]) |> last() |> sort(columns: [\"_value\"]) |> limit(n: 5)"
        }
      ]
    },
    {
      "id": 6,
      "type": "stat",
      "title": "P95 execution time (7d)",
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 6 },
      "fieldConfig": { "defaults": { "unit": "ms" } },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "influxdb", "uid": "influxdb" },
          "query": "from(bucket: \"test-runs\") |> range(start: -7d) |> filter(fn: (r) => r._measurement == \"test_run\" and r._field == \"duration_ms\") |> quantile(q: 0.95)"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Pipeline duration trend",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 15 },
      "fieldConfig": { "defaults": { "unit": "s" } },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "influxdb", "uid": "influxdb" },
          "query": "from(bucket: \"test-runs\") |> range(start: -30d) |> filter(fn: (r) => r._measurement == \"pipeline_duration\" and r._field == \"duration_seconds\") |> aggregateWindow(every: 1d, fn: mean)"
        }
      ]
    }
  ]
}
