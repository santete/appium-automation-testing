# Copy → .env.local; .env.local KHÔNG commit (xem .gitignore)
#
# M3 status (2026-04-27): D2 repaid. Smoke test dùng AccountPool + UserFactory
# qua global hook (`tests/_hooks/global.ts`) — KHÔNG còn hardcoded creds.

# ─── Profile selector ──────────────────────────────────────
# 'local' = Android emulator + Sauce Demo APK (M3 default)
# 'staging' = device farm — BrowserStack (M4 sẽ wire up)
ENV_PROFILE=local

# ─── Local emulator capabilities ───────────────────────────
ANDROID_DEVICE_NAME=Pixel_6_API_33
ANDROID_PLATFORM_VERSION=13
APP_PATH=./apps/SauceLabs-Demo-App.apk

# ─── Wait timeouts (ms) ────────────────────────────────────
DEFAULT_WAIT_TIMEOUT=10000
DEFAULT_WAIT_INTERVAL=500

# ─── Account pool ──────────────────────────────────────────
ACCOUNT_POOL_CONFIG_PATH=./src/utils/accountPool/pool.config.json
ACCOUNT_POOL_STATE_PATH=./tmp/account-pool.state.json

# ─── Network simulation default ────────────────────────────
# Profile cho `mobile:networkSpeed` Android emulator throttle.
# Options: full | lte | umts | edge | gprs | none
NETWORK_SIM_DEFAULT=full

# ─── Integration tests gating ──────────────────────────────
# Set "1" để cho phép integration test gọi public API thật (httpbin.org).
# Default empty → tests skip để không depend network trên CI offline.
ALLOW_NETWORK_INTEGRATION=

# ─── Device farm STUB (M5+ activate) ───────────────────────
# M4 (Q2 sign-off 2026-04-28): KHÔNG wire device farm. `wdio.bs.ts` +
# `wdio.sauce.ts` ship như STUB throw-on-load. M5+ unblock khi có account
# → fill creds + remove throw guard trong file.
#
# BrowserStack:
BS_USERNAME=
BS_ACCESS_KEY=
BS_APP_URL=

# Sauce Labs RDC:
SAUCE_USERNAME=
SAUCE_ACCESS_KEY=
SAUCE_APP_STORAGE_ID=

# ─── M5 LLM adapter (Decision 2 sign-off 2026-04-28) ───────
# Provider-agnostic adapter — Phuc fill `.env.local` (KHÔNG commit) khi
# sẵn sàng dùng LLM cho classifier escalation + self-healing suggester.
#
# Provider:
#   anthropic = Claude API (claude-sonnet-4-6 / claude-haiku-4-5-20251001 / claude-opus-4-7)
#   openai    = OpenAI API (gpt-4o-mini / gpt-4o)
#   gemini    = Google Gemini API (gemini-2.5-flash / gemini-2.5-flash-lite / gemini-2.5-pro)
#   ollama    = local Ollama server (llama3.1:8b / qwen2.5:7b)
#   none      = disable LLM, fallback rule-only (safe default)
LLM_PROVIDER=none
LLM_API_KEY=
LLM_MODEL=
LLM_BASE_URL=
LLM_BUDGET_MONTHLY_USD=20
LLM_SPEND_STATE_PATH=./tmp/llm-spend.json

# ─── M5 InfluxDB metrics emit ──────────────────────────────
# Set khi chạy dashboard infra (infra/observability/docker-compose.yaml up).
# Empty → emitter no-op (test run vẫn pass).
INFLUX_URL=
INFLUX_TOKEN=
INFLUX_ORG=
INFLUX_BUCKET=

# ─── M5 SMTP notify fallback ───────────────────────────────
# GH Issue auto-create là primary; email fallback cho urgent off-hours.
# Empty → notify workflow chỉ open GH Issue, skip email.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
ALERT_EMAIL_TO=

# ─── M6 Perf SLA env-aware overrides (D7 + D8) ─────────────
# Spec §7.5 perf threshold calibrated for **real device** (Pixel 6
# USB-tethered). Emulator P95 baseline ~4-5x slower (RCA TC_PERF_LOGIN_001
# 2026-05-01). Mỗi `AC_PERF_*.yaml` declare `threshold_env_var`; spec
# implementation đọc qua `resolvePerfThreshold()` helper.
#
# Real device (default): leave commented, contract `max_ms` is used.
# Emulator: uncomment block dưới để override (suggested 4x baseline).
# Manual override: set `PERF_FORCE_DEVICE_TYPE=real|emulator` nếu auto-
# detect (heuristic theo `ANDROID_DEVICE_NAME`) misclassify.
#
# === Emulator profile (uncomment khi chạy emulator) ===
# PERF_LOGIN_SLA_MS=5000        # contract default 2000 → emulator 5000
# PERF_CHECKOUT_SLA_MS=12000    # contract default 5000 → emulator 12000
# PERF_SEARCH_SLA_MS=4000       # contract default 1500 → emulator 4000
# PERF_FORCE_DEVICE_TYPE=       # 'real' | 'emulator' (override heuristic)
