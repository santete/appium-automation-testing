# Copy → .env.local; .env.local KHÔNG commit (xem .gitignore)
#
# M3 status (2026-04-27): D2 repaid. Smoke test dùng AccountPool + UserFactory
# qua global hook (`tests/_hooks/global.ts`) — KHÔNG còn hardcoded creds.

# ─── Profile selector ──────────────────────────────────────
# 'local' = Android emulator + Sauce Demo APK (M3 default)
# 'staging' = device farm — BrowserStack (M4 sẽ wire up)
ENV_PROFILE=local

# ─── Local emulator capabilities ───────────────────────────
ANDROID_DEVICE_NAME=Pixel_6_API_33
ANDROID_PLATFORM_VERSION=13
APP_PATH=./apps/SauceLabs-Demo-App.apk

# ─── Wait timeouts (ms) ────────────────────────────────────
DEFAULT_WAIT_TIMEOUT=10000
DEFAULT_WAIT_INTERVAL=500

# ─── Account pool ──────────────────────────────────────────
ACCOUNT_POOL_CONFIG_PATH=./src/utils/accountPool/pool.config.json
ACCOUNT_POOL_STATE_PATH=./tmp/account-pool.state.json

# ─── Network simulation default ────────────────────────────
# Profile cho `mobile:networkSpeed` Android emulator throttle.
# Options: full | lte | umts | edge | gprs | none
NETWORK_SIM_DEFAULT=full

# ─── Integration tests gating ──────────────────────────────
# Set "1" để cho phép integration test gọi public API thật (httpbin.org).
# Default empty → tests skip để không depend network trên CI offline.
ALLOW_NETWORK_INTEGRATION=

# ─── Device farm STUB (M5+ activate) ───────────────────────
# M4 (Q2 sign-off 2026-04-28): KHÔNG wire device farm. `wdio.bs.ts` +
# `wdio.sauce.ts` ship như STUB throw-on-load. M5+ unblock khi có account
# → fill creds + remove throw guard trong file.
#
# BrowserStack:
BS_USERNAME=
BS_ACCESS_KEY=
BS_APP_URL=

# Sauce Labs RDC:
SAUCE_USERNAME=
SAUCE_ACCESS_KEY=
SAUCE_APP_STORAGE_ID=
