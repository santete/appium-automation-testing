{
  "name": "mobile-automation",
  "version": "0.1.0",
  "private": true,
  "description": "Mobile automation testing framework — Android local (M1), iOS via cloud farm (M4)",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "wdio run ./src/config/wdio.local.ts",
    "test:unit": "mocha --config .mocharc.unit.cjs",
    "test:integration": "mocha --config .mocharc.integration.cjs",
    "test:api": "mocha --config .mocharc.api.cjs",
    "test:smoke": "wdio run ./src/config/wdio.local.ts --suite smoke",
    "test:smoke:20x": "node ./scripts/run-smoke-Nx.cjs 20",
    "test:regression": "wdio run ./src/config/wdio.local.ts --suite regression",
    "test:negative": "wdio run ./src/config/wdio.local.ts --suite negative",
    "test:nightly": "wdio run ./src/config/wdio.local.ts --suite nightly",
    "lint": "eslint . --ext .ts",
    "lint:fix": "eslint . --ext .ts --fix",
    "format": "prettier --write \"**/*.{ts,json,md,yaml,yml}\"",
    "format:check": "prettier --check \"**/*.{ts,json,md,yaml,yml}\"",
    "typecheck": "tsc --noEmit",
    "check:quarantine": "node ./scripts/check-quarantine.cjs",
    "build:test-apk": "node ./scripts/build-test-apk.cjs",
    "allure:generate": "allure generate ./reports/allure-results -o ./reports/allure-report --clean",
    "allure:open": "allure open ./reports/allure-report",
    "allure:serve": "allure serve ./reports/allure-results"
  },
  "devDependencies": {
    "@types/chai": "^4.3.16",
    "@types/js-yaml": "^4.0.9",
    "@types/mocha": "^10.0.7",
    "@types/node": "^22.0.0",
    "@types/proper-lockfile": "^4.1.4",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "@wdio/allure-reporter": "^8.40.0",
    "@wdio/appium-service": "^8.40.0",
    "@wdio/cli": "^8.40.0",
    "@wdio/local-runner": "^8.40.0",
    "@wdio/mocha-framework": "^8.40.0",
    "@wdio/spec-reporter": "^8.40.0",
    "allure-commandline": "^2.30.0",
    "appium": "^2.11.0",
    "appium-uiautomator2-driver": "^3.7.0",
    "chai": "^4.5.0",
    "dotenv": "^16.4.5",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.2.1",
    "expect-webdriverio": "^4.15.0",
    "msw": "^2.13.6",
    "prettier": "^3.3.3",
    "proper-lockfile": "^4.1.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.5.4"
  },
  "dependencies": {
    "axios": "^1.15.2",
    "js-yaml": "^4.1.1",
    "zod": "^4.3.6"
  }
}
